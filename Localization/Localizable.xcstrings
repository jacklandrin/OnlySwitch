    "OnlySwitch can change supported switches without asking for your password again." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch může změnit podporované přepínače, aniž by znovu požadoval vaše heslo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch kann unterstützte Schalter ändern, ohne erneut nach Ihrem Passwort zu fragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch can change supported switches without asking for your password again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch puede cambiar los conmutadores compatibles sin volver a solicitar su contraseña."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring baguhin ng OnlySwitch ang mga sinusuportahang switch nang hindi hinihingi muli ang iyong password."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch peut modifier les commutateurs pris en charge sans demander à nouveau votre mot de passe."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch može promijeniti podržane prekidače bez ponovnog traženja lozinke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch può modificare gli switch supportati senza richiedere nuovamente la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch は、パスワードを再度要求することなく、サポートされているスイッチを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch는 비밀번호를 다시 묻지 않고도 지원되는 스위치를 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch kan ondersteunde schakelaars wijzigen zonder opnieuw om uw wachtwoord te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch może zmienić obsługiwane przełączniki bez ponownego pytania o hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch pode alterar os switches suportados sem solicitar sua senha novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch может менять поддерживаемые переключатели, не запрашивая повторно пароль."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch môže zmeniť podporované prepínače bez toho, aby ste znova požadovali heslo."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch ayaa bedeli kara furayaasha la taageero adoon waydiisan eraygaaga sirta ah mar kale."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch, şifrenizi tekrar sormadan desteklenen anahtarları değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch може змінювати підтримувані перемикачі без повторного запиту пароля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch 可以更改支持的开关，而无需再次询问您的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch 可以更改支援的開關，而無需再次詢問您的密碼。"
          }
        }
      }
    },
    "OnlySwitch could not find its privileged helper. Repair privileged access to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch nemohl najít svého privilegovaného pomocníka. Chcete-li pokračovat, opravte privilegovaný přístup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch konnte seinen privilegierten Helfer nicht finden. Reparieren Sie den privilegierten Zugriff, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch could not find its privileged helper. Repair privileged access to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch no pudo encontrar su ayudante privilegiado. Repare el acceso privilegiado para continuar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mahanap ng OnlySwitch ang privileged helper nito. Ayusin ang privileged access para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch n'a pas pu trouver son assistant privilégié. Réparez l’accès privilégié pour continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch nije mogao pronaći svog privilegiranog pomoćnika. Popravite povlašteni pristup za nastavak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch non è riuscito a trovare il suo aiutante privilegiato. Ripara l'accesso privilegiato per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch はその特権ヘルパーを見つけることができませんでした。続行するには特権アクセスを修復してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch가 권한 있는 도우미를 찾을 수 없습니다. 계속하려면 권한 있는 액세스를 복구하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch kon zijn bevoorrechte helper niet vinden. Herstel bevoorrechte toegang om door te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch nie mógł znaleźć swojego uprzywilejowanego pomocnika. Napraw dostęp uprzywilejowany, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch não conseguiu encontrar seu ajudante privilegiado. Repare o acesso privilegiado para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch не смог найти своего привилегированного помощника. Восстановите привилегированный доступ, чтобы продолжить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch nenašiel svojho privilegovaného pomocníka. Ak chcete pokračovať, opravte privilegovaný prístup."
          }
