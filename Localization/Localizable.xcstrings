    "Supported switches will ask for authorization again if you set them after removal." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporované přepínače budou znovu žádat o autorizaci, pokud je nastavíte po odebrání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützte Schalter werden erneut zur Autorisierung aufgefordert, wenn Sie sie nach dem Entfernen festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supported switches will ask for authorization again if you set them after removal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los conmutadores compatibles solicitarán autorización nuevamente si los configura después de eliminarlos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga sinusuportahang switch ay hihingi muli ng pahintulot kung itatakda mo ang mga ito pagkatapos alisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commutateurs pris en charge demanderont à nouveau une autorisation si vous les configurez après la suppression."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržani prekidači ponovno će tražiti autorizaciju ako ih postavite nakon uklanjanja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli interruttori supportati richiederanno nuovamente l'autorizzazione se li imposti dopo la rimozione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされているスイッチは、削除後に設定すると再度認証を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 스위치를 제거한 후 설정하면 다시 인증을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondersteunde schakelaars zullen opnieuw om autorisatie vragen als u ze na verwijdering instelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługiwane przełączniki poproszą o ponowną autoryzację, jeśli ustawisz je po usunięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os switches suportados solicitarão autorização novamente se você os configurar após a remoção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаемые переключатели снова запросят авторизацию, если вы установите их после удаления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporované prepínače budú žiadať autorizáciu znova, ak ich nastavíte po odstránení."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shidayaasha la taageeray waxay ku weydiin doonaan oggolaan mar labaad haddii aad dejiso ka saarista ka dib."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenen anahtarları kaldırdıktan sonra ayarlarsanız tekrar yetkilendirme isteyecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтримувані перемикачі знову запитуватимуть авторизацію, якщо ви налаштуєте їх після видалення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您在删除后设置受支持的开关，它们将再次请求授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您在刪除後設定受支援的開關，它們將再次要求授權。"
          }
        }
      }
    },
