    "Waiting for audio. Check audio recording permission if playback is silent." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čekání na zvuk. Pokud je přehrávání tiché, zkontrolujte oprávnění k záznamu zvuku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf Audio. Prüfe die Berechtigung zur Audioaufnahme, falls die Wiedergabe stumm bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for audio. Check audio recording permission if playback is silent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando audio. Revisa el permiso de grabación de audio si la reproducción no tiene sonido."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naghihintay ng audio. Tingnan ang pahintulot sa pag-record ng audio kung walang tunog ang pag-play."
