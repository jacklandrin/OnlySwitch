    "Share your settings with a backup file, or restore them on another Mac" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Sdílejte nastavení pomocí záložního souboru nebo je obnovte na jiném Macu" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Teilen Sie Ihre Einstellungen mit einer Sicherungsdatei oder stellen Sie sie auf einem anderen Mac wieder her" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Share your settings with a backup file, or restore them on another Mac" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comparte tus ajustes con un archivo de copia de seguridad o restáuralos en otro Mac" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Ibahagi ang iyong mga setting gamit ang backup file, o i-restore ang mga ito sa ibang Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Partagez vos réglages avec un fichier de sauvegarde ou restaurez-les sur un autre Mac" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Dijelite postavke pomoću sigurnosne kopije ili ih vratite na drugom Macu" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Condividi le impostazioni con un file di backup o ripristinale su un altro Mac" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップファイルで設定を共有したり、別のMacで復元したりできます" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "백업 파일로 설정을 공유하거나 다른 Mac에서 복원하세요" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deel uw instellingen met een back-upbestand of herstel ze op een andere Mac" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Udostępniaj ustawienia za pomocą pliku kopii zapasowej lub przywracaj je na innym Macu" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Compartilhe seus ajustes com um arquivo de backup ou restaure-os em outro Mac" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Делитесь настройками с помощью файла резервной копии или восстанавливайте их на другом Mac" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zdieľajte nastavenia pomocou záložného súboru alebo ich obnovte na inom Macu" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "La wadaag dejimahaaga fayl kayd ah ama ku soo celi Mac kale" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayarlarınızı bir yedekleme dosyasıyla paylaşın veya başka bir Mac'te geri yükleyin" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Діліться налаштуваннями за допомогою файлу резервної копії або відновлюйте їх на іншому Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用备份文件分享设置，或在另一台 Mac 上恢复设置" } } } },
    "Settings exported successfully" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nastavení byla úspěšně exportována" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen erfolgreich exportiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings exported successfully" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes exportados correctamente" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Matagumpay na na-export ang mga setting" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages exportés avec succès" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Postavke su uspješno izvezene" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impostazioni esportate correttamente" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定を書き出しました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정을 성공적으로 내보냈습니다" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Instellingen geëxporteerd" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ustawienia wyeksportowano pomyślnie" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes exportados com sucesso" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки успешно экспортированы" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nastavenia boli úspešne exportované" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Dejimaha si guul leh ayaa loo dhoofiyay" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayarlar başarıyla dışa aktarıldı" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Налаштування успішно експортовано" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置已成功导出" } } } },
    "Settings imported. Restart Only Switch to apply all changes" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Nastavení byla importována. Restartujte Only Switch, aby se použily všechny změny" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen importiert. Starten Sie Only Switch neu, um alle Änderungen anzuwenden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings imported. Restart Only Switch to apply all changes" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes importados. Reinicia Only Switch para aplicar todos los cambios" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Na-import ang mga setting. I-restart ang Only Switch para mailapat ang lahat ng pagbabago" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages importés. Redémarrez Only Switch pour appliquer toutes les modifications" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Postavke su uvezene. Ponovno pokrenite Only Switch da biste primijenili sve promjene" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impostazioni importate. Riavvia Only Switch per applicare tutte le modifiche" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定を読み込みました。すべての変更を適用するにはOnly Switchを再起動してください" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정을 가져왔습니다. 모든 변경 사항을 적용하려면 Only Switch를 재시동하세요" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Instellingen geïmporteerd. Herstart Only Switch om alle wijzigingen toe te passen" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ustawienia zaimportowano. Uruchom ponownie Only Switch, aby zastosować wszystkie zmiany" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes importados. Reinicie o Only Switch para aplicar todas as alterações" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки импортированы. Перезапустите Only Switch, чтобы применить все изменения" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nastavenia boli importované. Reštartujte Only Switch, aby sa použili všetky zmeny" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Dejimaha waa la soo geliyay. Dib u bilow Only Switch si aad u dabaqdo dhammaan isbeddellada" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayarlar içe aktarıldı. Tüm değişiklikleri uygulamak için Only Switch'i yeniden başlatın" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Налаштування імпортовано. Перезапустіть Only Switch, щоб застосувати всі зміни" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置已导入。重新启动 Only Switch 以应用所有更改" } } } },
    "Invalid Settings Backup File" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Neplatný soubor se zálohou nastavení" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ungültige Einstellungs-Sicherungsdatei" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Invalid Settings Backup File" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Archivo de copia de seguridad de ajustes no válido" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Di-wastong backup file ng mga setting" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fichier de sauvegarde des réglages non valide" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Nevažeća datoteka sigurnosne kopije postavki" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "File di backup delle impostazioni non valido" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定のバックアップファイルが無効です" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "잘못된 설정 백업 파일" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ongeldig back-upbestand met instellingen" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nieprawidłowy plik kopii zapasowej ustawień" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Arquivo de backup de ajustes inválido" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Недопустимый файл резервной копии настроек" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Neplatný súbor zálohy nastavení" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Fayl kayd dejime oo aan sax ahayn" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geçersiz Ayar Yedekleme Dosyası" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Недійсний файл резервної копії налаштувань" } }, "zh-Hans" : { "stringUnit" : { "