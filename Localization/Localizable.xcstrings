          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriseer OnlySwitch één keer om ondersteunde switches te gebruiken zonder herhaalde wachtwoordvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoryzuj OnlySwitch raz, aby korzystać z obsługiwanych przełączników bez powtarzających się monitów o hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
