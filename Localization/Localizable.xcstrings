    "Tailscale Account Notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte účet a přihlaste se v prohlížeči. Aktivní může být vždy jen jeden účet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Account hinzu und melde dich im Browser an. Es kann immer nur ein Account aktiv sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an account to sign in using your browser. Only one account can be active at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una cuenta para iniciar sesión en el navegador. Solo puede haber una cuenta activa a la vez."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng account para mag-sign in gamit ang browser. Isang account lang ang maaaring maging aktibo sa bawat pagkakataon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un compte pour vous connecter dans votre navigateur. Un seul compte peut être actif à la fois."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte račun za prijavu u pregledniku. Samo jedan račun može biti aktivan odjednom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un account per accedere dal browser. Può essere attivo un solo account alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを追加してブラウザでログインしてください。同時に使用できるアカウントは1つです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 추가하여 브라우저에서 로그인하세요. 한 번에 하나의 계정만 활성화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een account toe om via je browser in te loggen. Er kan maar één account tegelijk actief zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj konto, aby zalogować się w przeglądarce. Jednocześnie może być aktywne tylko jedno konto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma conta para entrar pelo navegador. Apenas uma conta pode estar ativa por vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте учётную запись для входа через браузер. Одновременно может быть активна только одна учётная запись."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte účet a prihláste sa v prehliadači. Aktívny môže byť vždy iba jeden účet."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku dar akoon si aad uga gasho biraawsarkaaga. Hal akoon oo keliya ayaa mar kasta firfircoonaan kara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcınızda oturum açmak için hesap ekleyin. Aynı anda yalnızca bir hesap etkin olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте обліковий запис, щоб увійти в браузері. Одночасно може бути активним лише один обліковий запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加账户以在浏览器中登录。同一时间只能启用一个账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增帳號以在瀏覽器中登入。同一時間只能啟用一個帳號。"
          }
        }
      }
    },
