    "GPU readings use undocumented macOS interfaces and may stop working after a system update." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje GPU používají nedokumentovaná rozhraní macOS a po aktualizaci systému mohou přestat fungovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-Werte verwenden nicht dokumentierte macOS-Schnittstellen und funktionieren nach einem Systemupdate möglicherweise nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU readings use undocumented macOS interfaces and may stop working after a system update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecturas de GPU usan interfaces de macOS no documentadas y pueden dejar de funcionar tras una actualización del sistema."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ang mga pagbasa ng GPU ng mga hindi dokumentadong interface ng macOS at maaaring huminto pagkatapos ng update sa system."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures du GPU utilisent des interfaces macOS non documentées et peuvent cesser de fonctionner après une mise à jour du système."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očitavanja GPU-a koriste nedokumentirana sučelja sustava macOS i mogu prestati raditi nakon ažuriranja sustava."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le letture GPU usano interfacce macOS non documentate e potrebbero smettere di funzionare dopo un aggiornamento del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU情報は非公開のmacOSインターフェイスを使用するため、システム更新後に動作しなくなる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 정보는 공개되지 않은 macOS 인터페이스를 사용하므로 시스템 업데이트 후 작동하지 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-metingen gebruiken ongedocumenteerde macOS-interfaces en werken mogelijk niet meer na een systeemupdate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczyty GPU korzystają z nieudokumentowanych interfejsów macOS i mogą przestać działać po uaktualnieniu systemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As leituras da GPU usam interfaces não documentadas do macOS e podem parar de funcionar após uma atualização do sistema."
          }
        },
        "ru" : {
