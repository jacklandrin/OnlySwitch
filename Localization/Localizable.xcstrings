    "External monitors follow the built-in display's brightness (F1/F2) via DDC/CI." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externí monitory sledují jas vestavěného displeje (F1/F2) přes DDC/CI."
