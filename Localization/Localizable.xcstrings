    "Enabled indicators keep the monitor sampling while the popover is closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolené indikátory pokračují ve sběru dat, i když je vyskakovací okno zavřené."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivierte Anzeigen erfassen weiter Daten, während das Popover geschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled indicators keep the monitor sampling while the popover is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los indicadores activados siguen recopilando datos aunque la ventana emergente esté cerrada."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag naka-enable ang mga indicator, patuloy na nagsa-sample ang monitor kahit sarado ang popover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les indicateurs activés maintiennent la collecte même lorsque la fenêtre contextuelle est fermée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućeni indikatori nastavljaju uzorkovanje i dok je skočni prozor zatvoren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indicatori attivi mantengono il monitoraggio quando il pannello è chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インジケータを有効にすると、ポップオーバーを閉じている間も監視を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화된 표시기는 팝오버가 닫혀 있어도 모니터링을 계속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingeschakelde indicatoren blijven meten terwijl de pop-over gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone wskaźniki utrzymują monitorowanie także po zamknięciu okna podręcznego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os indicadores ativados mantêm o monitoramento enquanto o pop-up está fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включённые индикаторы продолжают сбор данных, пока всплывающее окно закрыто."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolené indikátory pokračujú v zbere údajov, aj keď je vyskakovacie okno zatvorené."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilmaamayaasha la hawlgeliyey waxay sii wadaan muunad-qaadista marka daaqadda soo-baxda xiran tahay."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
