          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声を待っています。再生中に音が出ない場合は、音声収録の許可を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
