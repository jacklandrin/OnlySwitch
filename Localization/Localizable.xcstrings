    "Tailscale Exit Node Notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po schválení správcem mohou ostatní zařízení směrovat internetový provoz přes tento Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
