    "Selected output devices are disconnected. Audio follows the app’s original output until they reconnect." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybraná výstupní zařízení jsou odpojena. Do opětovného připojení aplikace používá původní výstup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Ausgabegeräte sind getrennt. Bis zur erneuten Verbindung verwendet die App ihre ursprüngliche Ausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected output devices are disconnected. Audio follows the app’s original output until they reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos de salida seleccionados están desconectados. La app usará su salida original hasta que se vuelvan a conectar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadiskonekta ang mga napiling output device. Gagamitin ang orihinal na output ng app hanggang kumonekta silang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les périphériques de sortie sélectionnés sont déconnectés. L’app utilise sa sortie d’origine jusqu’à leur reconnexion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabrani izlazni uređaji su odspojeni. Do ponovnog povezivanja aplikacija koristi izvorni izlaz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dispositivi di uscita selezionati sono scollegati. L’app usa la sua uscita originale fino alla riconnessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した出力デバイスが切断されています。再接続されるまで、アプリ本来の出力が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 출력 기기의 연결이 끊어졌습니다. 다시 연결될 때까지 앱의 원래 출력으로 오디오가 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde uitvoerapparaten zijn losgekoppeld. De app gebruikt de oorspronkelijke uitvoer totdat ze opnieuw zijn verbonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane urządzenia wyjściowe są odłączone. Do ponownego połączenia aplikacja używa swojego pierwotnego wyjścia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos de saída selecionados estão desconectados. O app usará a saída original até que sejam reconectados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные устройства вывода отключены. До их подключения приложение использует исходный выход."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané výstupné zariadenia sú odpojené. Do opätovného pripojenia aplikácia používa pôvodný výstup."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qalabka cod-bixinta ee la doortay waa go’an yihiin. Abku wuxuu isticmaalaa cod-bixintiisii hore ilaa dib loo xiro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen çıkış aygıtları bağlı değil. Yeniden bağlanana kadar uygulamanın özgün ses çıkışı kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрані пристрої виводу від’єднано. До їх повторного підключення програма використовує початковий вихід."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选输出设备已断开连接。重新连接前，音频将使用 App 原来的输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選輸出裝置已中斷連線。重新連線前，音訊將使用 App 原本的輸出。"
          }
        }
      }
    },
