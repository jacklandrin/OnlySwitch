          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizza OnlySwitch una volta per utilizzare gli switch supportati senza richieste ripetute di password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch を 1 回承認すると、パスワード プロンプトを繰り返すことなくサポートされているスイッチを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
