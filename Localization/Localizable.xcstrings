        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op audio. Controleer de toestemming voor audio-opname als er bij het afspelen geen geluid is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
