    "Authorization approval needed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authorization approval needed" } } } },
    "Privileged access disabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privileged access disabled" } } } },
    "Privileged helper unavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privileged helper unavailable" } } } },
    "OnlySwitch can change supported switches without asking for your password again." : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OnlySwitch can change supported switches without asking for your password again." } } } },
    "Authorize OnlySwitch once to use supported switches without repeated password prompts." : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Authorize OnlySwitch once to use supported switches without repeated password prompts." } } } },
    "Approve OnlySwitch's privileged helper in System Settings to continue." : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Approve OnlySwitch's privileged helper in System Settings to continue." } } } },
