    "Usage history and cost estimates can be enabled separately after you review their privacy notice." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historii využití a odhady nákladů lze zapnout samostatně po přečtení oznámení o ochraně soukromí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsverlauf und Kostenschätzungen können separat aktiviert werden, nachdem du den Datenschutzhinweis gelesen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage history and cost estimates can be enabled separately after you review their privacy notice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de uso y las estimaciones de costos se pueden activar por separado después de revisar su aviso de privacidad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring i-enable nang hiwalay ang history ng paggamit at mga pagtatantiya ng gastos pagkatapos mong suriin ang abiso sa privacy ng mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique d’utilisation et les estimations de coût peuvent être activés séparément après consultation de leur avis de confidentialité."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povijest upotrebe i procjene troškova mogu se zasebno omogućiti nakon što pregledate njihovu obavijest o privatnosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia di utilizzo e le stime dei costi possono essere abilitate separatamente dopo aver consultato l’informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用履歴とコストの推定は、プライバシーに関する通知を確認した後で個別に有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 안내를 검토한 후 사용 기록과 비용 추정치를 별도로 활성화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruiksgeschiedenis en kostenschattingen kunnen afzonderlijk worden ingeschakeld nadat je de privacyverklaring hebt bekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historię użycia i szacunkowe koszty można włączyć osobno po zapoznaniu się z informacją o prywatności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de uso e as estimativas de custo podem ser ativados separadamente após você revisar o aviso de privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Историю использования и оценку затрат можно включить отдельно после ознакомления с уведомлением о конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Históriu využitia a odhady nákladov možno zapnúť samostatne po prečítaní oznámenia o ochrane súkromia."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taariikhda isticmaalka iyo qiyaasaha kharashka si gooni ah ayaa loo hawlgelin karaa ka dib markaad akhrido ogeysiiskooda asturnaanta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım geçmişi ve maliyet tahminleri, gizlilik bildirimlerini inceledikten sonra ayrı ayrı etkinleştirilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історію використання й оцінку витрат можна ввімкнути окремо після ознайомлення з повідомленням про конфіденційність."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看隐私声明后，可以分别启用使用历史记录和费用估算。"
          }
        },
        "zh-Hant" : {
