    "The feature can be triggered when right clicking the arrow-pointing icon, and disabled by right clicking the App icon." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkci lze aktivovat kliknutím pravým tlačítkem na ikonu se šipkou a deaktivovat kliknutím pravým tlačítkem na ikonu aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Feature kann ausgelöst werden, wenn Sie mit der rechten Maustaste auf das Pfeil-Symbol klicken, und durch Klicken mit der rechten Maustaste auf das App-Symbol deaktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The feature can be triggered when right clicking the arrow-pointing icon, and disabled by right clicking the App icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La función se puede activar haciendo clic derecho en el icono de flecha y desactivar haciendo clic derecho en el icono de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fonctionnalité peut être déclenchée en cliquant avec le bouton droit de la souris sur l'icône pointant vers la flèche, et désactivée en cliquant avec le bouton droit de la souris sur l'icône de l'application."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Značajka se može pokrenuti desnim klikom na ikonu s usmjerenom strelicom i onemogućiti desnim klikom na ikonu programa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La funzione può essere attivata facendo clic con il pulsante destro sull'icona che punta la freccia e disattivata facendo clic con il pulsante destro sull'icona dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この機能は、矢印のアイコンを右クリックするとトリガーされ、アプリアイコンを右クリックすると無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능은 화살표 아이콘을 우클릭하면 트리거됩니다. 앱 아이콘을 우클릭하면 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De functie kan worden geactiveerd door met de rechtermuisknop op het pijlpictogram te klikken en worden uitgeschakeld door met de rechtermuisknop op het app-pictogram te klikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcję można uruchomić, klikając prawym przyciskiem myszy ikonę z wskazaniem strzałki, a wyłączyć, klikając prawym przyciskiem myszy ikonę aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A função pode ser acionada ao clicar com o botão direito no ícone de seta, e desativada ao clicar com o botão direito no ícone do aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция может быть запущена при щелчке правой кнопкой мыши по иконке со стрелкой и отключена при щелчке правой кнопкой мыши по иконке приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkciu možno spustiť kliknutím pravým tlačidlom myši na ikonu so šípkou a deaktivovať ju kliknutím pravým tlačidlom myši na ikonu aplikácie."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waxaa loo isticmaali karaa marka aad ku duubto astaanta bidixka, iyo la dami marka aad ku duubto App icon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özellik, ok işaretli simgeye sağ tıkladığınızda tetiklenebilir ve uygulama simgesine sağ tıkladığınızda devre dışı bırakılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю функцію можна активувати, натиснувши правою кнопкою миші на іконку зі стрілкою, і вимкнути, натиснувши правою кнопкою миші на іконку програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能可以通过右键单击箭头指向的图标来触发，并通过右键单击应用图标来禁用。"
          }
        }
      }
    },
