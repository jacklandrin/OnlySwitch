    "Authorize OnlySwitch once to use supported switches without repeated password prompts." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizujte OnlySwitch jednou k použití podporovaných přepínačů bez opakovaných výzev k zadání hesla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisieren Sie OnlySwitch einmal, um unterstützte Switches ohne wiederholte Passwortabfrage zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorize OnlySwitch once to use supported switches without repeated password prompts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorice a OnlySwitch una vez para utilizar conmutadores compatibles sin solicitudes repetidas de contraseña."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang OnlySwitch nang isang beses na gumamit ng mga sinusuportahang switch nang walang paulit-ulit na mga prompt ng password."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez OnlySwitch une fois pour utiliser les commutateurs pris en charge sans invites de mot de passe répétées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovlastite OnlySwitch jednom za korištenje podržanih prekidača bez ponovljenih upita za lozinku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizza OnlySwitch una volta per utilizzare gli switch supportati senza richieste ripetute di password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnlySwitch を 1 回承認すると、パスワード プロンプトを繰り返すことなくサポートされているスイッチを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반복되는 비밀번호 프롬프트 없이 지원되는 스위치를 사용하려면 OnlySwitch에 한 번만 권한을 부여하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriseer OnlySwitch één keer om ondersteunde switches te gebruiken zonder herhaalde wachtwoordvragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoryzuj OnlySwitch raz, aby korzystać z obsługiwanych przełączników bez powtarzających się monitów o hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorize OnlySwitch uma vez para usar switches suportados sem solicitações repetidas de senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторизуйте OnlySwitch один раз, чтобы использовать поддерживаемые переключатели без повторного запроса пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizujte OnlySwitch raz na používanie podporovaných prepínačov bez opakovaných výziev na zadanie hesla."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggolow KeliyaSwitch hal mar si aad u isticmaasho furayaasha la taageeray iyada oo aan la helin sirta soo noqnoqda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenen anahtarları tekrarlanan parola istemleri olmadan kullanmak için OnlySwitch'e bir kez yetki verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторизуйте OnlySwitch один раз, щоб використовувати підтримувані комутатори без повторних запитів пароля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权 OnlySwitch 一次即可使用支持的开关，无需重复提示密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權 OnlySwitch 一次即可使用支援的開關，無需重複提示密碼。"
          }
        }
      }
    },
