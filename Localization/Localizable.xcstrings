        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang OnlySwitch nang isang beses na gumamit ng mga sinusuportahang switch nang walang paulit-ulit na mga prompt ng password."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
