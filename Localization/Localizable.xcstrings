          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканируются стандартные папки Xcode. Пользовательские папки сборки проектов и Archives исключены. Перед очисткой закройте Xcode и Simulator."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenuje štandardné umiestnenia Xcode. Vlastné priečinky zostáv projektov a Archives sú vynechané. Pred čistením zatvorte Xcode a Simulator."
          }
