    "Control OnlySwitch from your iPhone or iPad when both devices are on the same local network." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control OnlySwitch from your iPhone or iPad when both devices are on the same local network."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládejte OnlySwitch z iPhonu nebo iPadu, když jsou obě zařízení ve stejné místní síti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuern Sie OnlySwitch von Ihrem iPhone oder iPad aus, wenn sich beide Geräte im selben lokalen Netzwerk befinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle OnlySwitch desde su iPhone o iPad cuando ambos dispositivos estén en la misma red local."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolin ang OnlySwitch mula sa iyong iPhone o iPad kapag ang parehong mga device ay nasa parehong lokal na network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez OnlySwitch depuis votre iPhone ou iPad lorsque les deux appareils sont sur le même réseau local."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravljajte aplikacijom OnlySwitch sa svog iPhonea ili iPada kada su oba uređaja na istoj lokalnoj mreži."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla OnlySwitch dal tuo iPhone o iPad quando entrambi i dispositivi sono sulla stessa rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスが同じローカル ネットワーク上にある場合、iPhone または iPad から OnlySwitch を制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 장치가 모두 동일한 로컬 네트워크에 있을 때 iPhone 또는 iPad에서 OnlySwitch를 제어하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedien OnlySwitch vanaf uw iPhone of iPad wanneer beide apparaten zich op hetzelfde lokale netwerk bevinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steruj OnlySwitch z iPhone’a lub iPada, gdy oba urządzenia są w tej samej sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle OnlySwitch do seu iPhone ou iPad quando ambos os dispositivos estiverem na mesma rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляйте OnlySwitch со своего iPhone или iPad, когда оба устройства находятся в одной локальной сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládajte OnlySwitch z vášho iPhone alebo iPad, keď sú obe zariadenia v rovnakej lokálnej sieti."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka maamul OnlySwitch iPhone-kaaga ama iPad-kaaga marka labada qalab ay ku jiraan isla shabakadda maxalliga ah."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
