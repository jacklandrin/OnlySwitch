    "You can update to new version. The latest version is v%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete aktualizovat na novou verzi. Nejnovější verze je v%@"
          }
