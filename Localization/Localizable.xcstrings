        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla OnlySwitch dal tuo iPhone o iPad quando entrambi i dispositivi sono sulla stessa rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスが同じローカル ネットワーク上にある場合、iPhone または iPad から OnlySwitch を制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 장치가 모두 동일한 로컬 네트워크에 있을 때 iPhone 또는 iPad에서 OnlySwitch를 제어하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedien OnlySwitch vanaf uw iPhone of iPad wanneer beide apparaten zich op hetzelfde lokale netwerk bevinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steruj OnlySwitch z iPhone’a lub iPada, gdy oba urządzenia są w tej samej sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle OnlySwitch do seu iPhone ou iPad quando ambos os dispositivos estiverem na mesma rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляйте OnlySwitch со своего iPhone или iPad, когда оба устройства находятся в одной локальной сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládajte OnlySwitch z vášho iPhone alebo iPad, keď sú obe zariadenia v rovnakej lokálnej sieti."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka maamul OnlySwitch iPhone-kaaga ama iPad-kaaga marka labada qalab ay ku jiraan isla shabakadda maxalliga ah."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her iki cihaz aynı yerel ağdayken OnlySwitch’i iPhone veya iPad’inizden kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керуйте OnlySwitch з iPhone або iPad, коли обидва пристрої підключені до однієї локальної мережі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 iPhone 或 iPad 与 Mac 连接到同一局域网时，即可通过 iPhone 或 iPad 控制 OnlySwitch。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
