    "Xcode Cleaner Standard Locations" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenuje standardní umístění Xcode. Vlastní složky sestavení projektů a archivy jsou vyloučeny. Před čištěním zavřete Xcode a Simulátor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannt die Standardverzeichnisse von Xcode. Eigene Build-Ordner von Projekten und Archive sind ausgeschlossen. Xcode und Simulator vor dem Bereinigen schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scans standard Xcode locations. Custom project build folders and Archives are excluded. Close Xcode and Simulator before cleaning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza las ubicaciones estándar de Xcode. Se excluyen las carpetas de compilación personalizadas y los archivos de compilaciones. Cierra Xcode y Simulator antes de limpiar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini-scan ang mga karaniwang lokasyon ng Xcode. Hindi kasama ang mga custom na build folder ng proyekto at Archives. Isara ang Xcode at Simulator bago maglinis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse les emplacements standard de Xcode. Les dossiers de compilation personnalisés des projets et les archives sont exclus. Fermez Xcode et Simulator avant le nettoyage."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenira standardne lokacije Xcodea. Prilagođene mape za izgradnju projekata i arhive nisu uključene. Zatvorite Xcode i Simulator prije čišćenja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona le posizioni standard di Xcode. Le cartelle di build personalizzate dei progetti e gli archivi sono esclusi. Chiudi Xcode e Simulator prima di pulire."
