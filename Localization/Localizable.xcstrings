    "This backup was made by a newer version of Only Switch" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato záloha byla vytvořena novější verzí Only Switch" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Sicherung wurde von einer neueren Version von Only Switch erstellt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This backup was made by a newer version of Only Switch" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta copia de seguridad se creó con una versión más reciente de Only Switch" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Ginawa ang backup na ito gamit ang mas bagong bersyon ng Only Switch" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette sauvegarde a été créée avec une version plus récente d’Only Switch" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Ova sigurnosna kopija izrađena je novijom verzijom Only Switcha" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo backup è stato creato da una versione più recente di Only Switch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このバックアップは、より新しいバージョンのOnly Switchで作成されています" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 백업은 최신 버전의 Only Switch에서 생성되었습니다" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deze back-up is gemaakt met een nieuwere versie van Only Switch" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ta kopia zapasowa została utworzona przez nowszą wersję Only Switch" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este backup foi criado por uma versão mais recente do Only Switch" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта резервная копия создана более новой версией Only Switch" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Táto záloha bola vytvorená novšou verziou Only Switch" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Kaydkan waxaa sameeyay nooc cusub oo Only Switch ah" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu yedek, Only Switch'in daha yeni bir sürümüyle oluşturuldu" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Цю резервну копію створено новішою версією Only Switch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此备份由较新版本的 Only Switch 创建" } } } },
    "Import custom Evolution commands?" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Importovat vlastní příkazy Evolution?" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Benutzerdefinierte Evolution-Befehle importieren?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import custom Evolution commands?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Importar comandos personalizados de Evolution?" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "I-import ang mga custom na Evolution command?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Importer les commandes Evolution personnalisées ?" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Uvesti prilagođene naredbe Evolutiona?" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Importare i comandi Evolution personalizzati?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カスタムEvolutionコマンドを読み込みますか？" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용자 지정 Evolution 명령을 가져오시겠습니까?" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Aangepaste Evolution-opdrachten importeren?" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Importować niestandardowe polecenia Evolution?" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Importar comandos personalizados do Evolution?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импортировать пользовательские команды Evolution?" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Importovať vlastné príkazy Evolution?" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Soo geli amarada gaarka ah ee Evolution?" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Özel Evolution komutları içe aktarılsın mı?" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Імпортувати власні команди Evolution?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要导入自定义 Evolution 命令吗？" } } } },
    "This backup contains shell commands that Only Switch will run on this Mac, some of them automatically. Only import them if you trust whoever created this file." : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Tato záloha obsahuje shellové příkazy, které Only Switch na tomto Macu spustí, některé automaticky. Importujte je pouze v případě, že důvěřujete tvůrci tohoto souboru." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Sicherung enthält Shell-Befehle, die Only Switch auf diesem Mac ausführen wird, einige davon automatisch. Importieren Sie sie nur, wenn Sie der Person vertrauen, die diese Datei erstellt hat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This backup contains shell commands that Only Switch will run on this Mac, some of them automatically. Only import them if you trust whoever created this file." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta copia de seguridad contiene comandos de shell que Only Switch ejecutará en este Mac, algunos automáticamente. Impórtalos solo si confías en quien creó este archivo." } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Naglalaman ang backup na ito ng mga shell command na tatakbuhin ng Only Switch sa Mac na ito, ang ilan ay awtomatiko. I-import lamang ang mga ito kung pinagkakatiwalaan mo ang gumawa ng file na ito." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette sauvegarde contient des commandes shell qu’Only Switch exécutera sur ce Mac, certaines automatiquement. Ne les importez que si vous faites confiance à la personne qui a créé ce fichier." } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Ova sigurnosna kopija sadrži naredbe ljuske koje će Only Switch pokrenuti na ovom Macu, neke automatski. Uvezite ih samo ako vjerujete osobi koja je izradila ovu datoteku." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo backup contiene comandi shell che Only Switch eseguirà su questo Mac, alcuni automaticamente. Importali solo se ti fidi di chi ha creato questo file." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このバックアップには、Only SwitchがこのMacで実行するシェルコマンドが含まれています。一部は自動的に実行されます。このファイルの作成者を信頼できる場合のみ読み込んでください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 백업에는 Only Switch가 이 Mac에서 실행할 셸 명령이 포함되어 있으며 일부는 자동으로 실행됩니다. 이 파일을 만든 사람을 신뢰하는 경우에만 가져오세요." } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deze back-up bevat shellopdrachten die Only Switch op deze Mac uitvoert, sommige automatisch. Importeer ze alleen als u de maker van dit bestand vertrouwt." } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ta kopia zapasowa zawiera polecenia powłoki, które Only Switch uruchomi na tym Macu, niektóre automatycznie. Importuj je tylko wtedy, gdy ufasz osobie, która utworzyła ten plik." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este backup contém comandos shell que o Only Switch executará neste Mac, alguns automaticamente. Importe-os somente se você confiar em quem criou este arquivo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта резервная копия содержит команды shell, которые Only Switch выполнит на этом Mac, некоторые автоматически. Импортируйте их, только если доверяете создателю этого файла." } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Táto záloha obsahuje shellové príkazy, ktoré Only Switch spustí na tomto Macu, niektoré automaticky. Importujte ich iba vtedy, ak dôverujete osobe, ktorá tento súbor vytvorila." } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Kaydkan wuxuu ka kooban yahay amarro qolof ah oo Only Switch ku shaqayn doono Mac-kan, qaar si toos ah. Soo geli oo keliya haddii aad ku kalsoon tahay qofkii faylkan sameeyay." } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu yedek, Only Switch'in bu Mac'te çalıştıracağı, bazıları otomatik olan kabuk komutlarını içerir. Yalnızca bu dosyayı oluşturan kişiye güveniyorsanız içe aktarın." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ця резервна копія містить команди shell, які Only Switch виконає на цьому Mac, деякі автоматично. Імпортуйте їх, лише якщо довіряєте автору цього файлу." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此备份包含 Only Switch 将在这台 Mac 上运行的 Shell 命令，其中一些会自动运行。仅当您信任此文件的创建者时才导入这些命令。" } } } },
    "Pre-execution:" : { "extractionState" : "manual", "localizations" : { "cs" : { "stringUnit" : { "state" : "translated", "value" : "Před spuštěním:" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Vor der Ausführung:" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pre-execution:" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Antes de la ejecución:" } }, "fil" : { "stringUnit" : { "state" : "translated", "value" : "Bago isagawa:" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Avant exécution :" } }, "hr" : { "stringUnit" : { "state" : "translated", "value" : "Prije izvršavanja:" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Prima dell'esecuzione:" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行前:" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 전:" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Vóór uitvoering:" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Przed wykonaniem:" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Antes da execução:" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перед выполнением:" } }, "sk" : { "stringUnit" : { "state" : "translated", "value" : "Pred spustením:" } }, "so" : { "stringUnit" : { "state" : "translated", "value" : "Kahor fulinta:" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yürütme öncesi:" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перед виконанням:" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "执行前：" } } } },
