        { "path": "main.swift", "target-membership": [ "OnlySwitchPrivilegedHelper/compile-sources" ] },
        { "path": "Info.plist" },
      ],
    },
    { "path": "Modules" },
    {
      "kind": "group",
      "path": "Localization",
