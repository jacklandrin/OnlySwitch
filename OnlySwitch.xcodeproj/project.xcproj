{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "es",
      "fil",
      "fr",
      "hr",
      "it",
      "ja",
      "ko",
      "nl",
      "pl",
      "pt-BR",
      "ru",
      "sk",
      "so",
      "tr",
      "uk",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-clocks",
      "version": {
        "version": "1.0.5",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/LaunchAtLogin",
      "version": {
        "version": "5.0.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/elai950/AlertToast.git",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Alamofire/Alamofire.git",
      "version": {
        "version": "5.5.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sindresorhus/KeyboardShortcuts",
      "version": {
        "up-to-next-major-version": "3.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/globulus/swiftui-webview",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-composable-architecture",
      "version": {
        "version": "1.26.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "version": "2.10.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/swift-markdown-ui",
      "version": {
        "up-to-next-major-version": "2.3.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-custom-dump",
      "version": {
        "up-to-next-major-version": "1.3.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-dependencies",
      "version": {
        "up-to-next-major-version": "1.9.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-case-paths",
      "version": {
        "version": "1.7.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-identified-collections",
      "version": {
        "version": "1.1.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-collections",
      "version": {
        "version": "1.1.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-issue-reporting.git",
      "version": {
        "up-to-next-major-version": "2.1.0",
      },
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "Config/Versions",
      "children": [
        { "path": "OnlySwitch.xcconfig" },
        { "path": "OnlySwitchRemote.xcconfig" },
      ],
    }, {
      "kind": "group",
      "path": "OnlySwitchPrivilegedHelper",
