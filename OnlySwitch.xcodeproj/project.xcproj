        {
          "kind": "script",
          "name": "Launch at Login Helper",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "# Type a script or drag a script file from your workspace to insert its path.",
            "\"${BUILT_PRODUCTS_DIR}/LaunchAtLogin_LaunchAtLogin.bundle/Contents/Resources/copy-helper-swiftpm.sh\"",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed App Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "shell": "/bin/sh",
          "script": [
            "\"${BUILT_PRODUCTS_DIR}/LaunchAtLogin_LaunchAtLogin.bundle/Contents/Resources/copy-helper-swiftpm.sh\"",
            "",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed Privileged Helper",
          "bundle-base-path": "root",
          "relative-path": "Contents/MacOS",
        }, {
          "kind": "copy",
          "name": "Copy Privileged Helper Daemon Plist",
          "bundle-base-path": "root",
          "relative-path": "Contents/Library/LaunchDaemons",
        }, {
          "kind": "script",
          "name": "Sign Sparkle for Distribution",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(WRAPPER_NAME)/Contents/Frameworks/Sparkle.framework",
          ],
          "scope": "install",
          "shell": "/bin/sh",
          "script": "\"${SRCROOT}/Scripts/sign-sparkle-for-distribution.sh\"\n",
        },
      ],
